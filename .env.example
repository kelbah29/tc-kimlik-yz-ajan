# Email/telefon bridge identity (tc-kimlik-ajan) — inkbox-claude bootstrap tarafından yazılır
INKBOX_API_KEY=
INKBOX_IDENTITY=
INKBOX_EMAIL=
HUMAN_EMAIL=
INKBOX_BASE_URL=https://inkbox.ai
CLAUDE_PROJECT_DIR=
INKBOX_ALLOW_ALL_USERS=true
INKBOX_SIGNING_KEY=
INKBOX_REQUIRE_SIGNATURE=true

# Website identity (tc-kimlik-web) — bu repodaki src/index.ts tarafından okunur
INKBOX_WEB_API_KEY=
INKBOX_WEB_IDENTITY=
INKBOX_WEB_EMAIL=

# Vapi (telefon kanalı) — dashboard.vapi.ai > Settings > API Keys > Private Key
VAPI_API_KEY=
# /chat/completions endpoint'ini korumak için rastgele bir sır (Vapi assistant'ının
# model.headers.Authorization = "Bearer <bu değer>" olarak ayarlanması gerekir)
PHONE_BRIDGE_SECRET=
